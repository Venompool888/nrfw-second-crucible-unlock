    <AssemblyName>NRFWPerformance</AssemblyName><RootNamespace>Performance</RootNamespace><Version>0.1.0</Version>
    <LangVersion>latest</LangVersion><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath><DebugType>none</DebugType>
