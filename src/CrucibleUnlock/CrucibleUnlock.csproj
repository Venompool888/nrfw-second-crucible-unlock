      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\vendor\generated\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>..\..\vendor\generated\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cpp__timeline">
      <HintPath>..\..\vendor\generated\Il2Cpp__timeline.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cpp__moonCore">
      <HintPath>..\..\vendor\generated\Il2Cpp__moonCore.dll</HintPath>
