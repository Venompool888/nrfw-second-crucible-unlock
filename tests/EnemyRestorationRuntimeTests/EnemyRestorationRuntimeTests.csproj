<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeSource Condition="'$(RuntimeSource)' == ''">../../src/CrucibleUnlock/EnemyRestorationRuntime.cs</RuntimeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Fakes.cs" />
    <Compile Include="$(RuntimeSource)" Link="EnemyRestorationRuntime.cs" />
    <Compile Include="../../src/CrucibleUnlock/EnemyRestorationCatalog.cs" Link="EnemyRestorationCatalog.cs" />
    <EmbeddedResource Include="../../research/enemy-restoration/bindings.json" LogicalName="NRFW.EnemyRestoration.Bindings.json" />
  </ItemGroup>
</Project>
