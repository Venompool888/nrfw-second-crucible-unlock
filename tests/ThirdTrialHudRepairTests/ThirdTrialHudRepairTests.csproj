<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <HudSource Condition="'$(HudSource)' == ''">../../src/CrucibleUnlock/ThirdTrialHudRepair.cs</HudSource>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs"/><Compile Include="Fakes.cs"/>
    <Compile Include="$(HudSource)" Link="ThirdTrialHudRepair.cs"/>
    <Content Include="ShippedHudMessages.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
