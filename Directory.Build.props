<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <VendorDir Condition="'$(VendorDir)' == ''">$(MSBuildThisFileDirectory)vendor</VendorDir>
    <VendorGeneratedDir Condition="'$(VendorGeneratedDir)' == ''">$(VendorDir)/generated</VendorGeneratedDir>
    <VendorRefsDir Condition="'$(VendorRefsDir)' == ''">$(VendorDir)/refs</VendorRefsDir>
  </PropertyGroup>
</Project>
